# Gemini API Key from Google AI Studio
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Brevo API Key for email sending
# Get yours at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here

# JWT Secret for admin authentication (minimum 32 chars)
# Generate with: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_here_minimum_32_chars

# Admin password (minimum 12 chars)
ADMIN_PASSWORD=your_strong_admin_password_here

# Kiwify Payment Gateway
KIWIFY_CLIENT_ID=your_kiwify_client_id
KIWIFY_CLIENT_SECRET=your_kiwify_client_secret
KIWIFY_ACCOUNT_ID=your_kiwify_account_id

# App mode: 'dev' for development, 'production' for production
APP_MODE=production
PORT=3001