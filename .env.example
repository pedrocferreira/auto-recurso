# OpenRouter (provedor principal de IA). Get yours at: https://openrouter.ai/keys
# Se definida, todas as chamadas de IA vão pelo OpenRouter; senão, usa o Gemini direto.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Opcional: modelo(s) a usar, separados por vírgula (fallback automático para google/gemini-3.6-flash e google/gemini-2.5-flash)
OPENROUTER_MODEL=

# Gemini API Key from Google AI Studio (fallback quando OPENROUTER_API_KEY não está definida)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Brevo API Key for email sending
# Get yours at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here

# JWT Secret for admin authentication (minimum 32 chars)
# Generate with: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_here_minimum_32_chars

# Admin password (minimum 12 chars)
ADMIN_PASSWORD=your_strong_admin_password_here

# Kiwify Payment Gateway
KIWIFY_CLIENT_ID=your_kiwify_client_id
KIWIFY_CLIENT_SECRET=your_kiwify_client_secret
KIWIFY_ACCOUNT_ID=your_kiwify_account_id
# Id do produto AutoRecurso na Kiwify (vendas de outros produtos da conta são ignoradas)
KIWIFY_PRODUCT_ID=c174b730-9a7c-11f1-bbcf-25eb95ac5a9e

# App mode: 'dev' for development, 'production' for production
APP_MODE=production
PORT=3001

# Retenção de dados pessoais, em dias (LGPD). Valores padrão abaixo; a política de privacidade cita esses prazos.
# RESOURCE_RETENTION_DAYS=90
# ABANDONED_CART_RETENTION_DAYS=30
# EVENT_PII_RETENTION_DAYS=90
# SALE_EMAIL_RETENTION_DAYS=90

# Remetente dos e-mails (deve ser um remetente validado na Brevo)
# EMAIL_SENDER=contato@autorecurso.online
